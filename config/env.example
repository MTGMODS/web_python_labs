# Приклад конфігурації. Скопіювати у корінь проєкту як .env
# PowerShell: Copy-Item config\env.example .env

APP_NAME=Bus Tickets Platform
DEBUG=true

# Підключення до PostgreSQL (драйвер psycopg3).
# Значення має відповідати сервісу db з deploy/docker-compose.yml
DATABASE_URL=postgresql+psycopg://bus_app:bus_app@localhost:5432/bus_tickets

# Пул з'єднань SQLAlchemy (буде налаштовуватись у лабораторних з оптимізації)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Окрема база для автотестів на тому ж сервері PostgreSQL
TEST_DATABASE_URL=postgresql+psycopg://bus_app:bus_app@localhost:5432/bus_tickets_test

# Підпис токенів доступу. Мінімум 32 байти (вимога HMAC-SHA256, RFC 7518).
# У реальному середовищі значення обов'язково інше та зберігається поза репозиторієм.
SECRET_KEY=dev-only-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Скільки хвилин місце утримується за користувачем до підтвердження оплати
SEAT_HOLD_MINUTES=10

# Початковий адміністратор, якого створює scripts/seed.py.
# Домен має бути звичайним: службові зони (.local, .test, example.com)
# відхиляються валідатором email під час реєстрації через API.
ADMIN_EMAIL=admin@busline.ua
ADMIN_PASSWORD=admin12345
